Bistrotorres.com</title>
  
  <meta name="description" content="Bistro Torres, restaurante de 4.7 estrellas en Valle de Bravo. Cocina de autor con vista al lago. Abierto jueves a domingo. Reserva tu mesa por WhatsApp." />
  <meta property="og:title" content="Bistro Torres · Cocina de autor frente al lago" />
  <meta property="og:description" content="Restaurante de 4.7 estrellas en Marina Nacional, Valle de Bravo. Cocina de autor, vista al lago y ambiente rústico-colonial." />
  <meta property="og:type" content="restaurant" />
  <meta property="og:image" content="https://media.base44.com/images/public/user_6a9cf72266f7b2377a14ce76/0689a2100_Screenshot_2026-09-05-22-41-02-33_3d9111e2d3171bf4882369f490c087b4.jpg" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --cream: #F2F0E6;
      --espresso: #3E2B24;
      --iron: #1A1410;
      --terracotta: #A65E4E;
      --tan: #D2B48C;
      --tan-dark: #b8975f;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--iron);
      color: var(--cream);
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }

    img {
      display: block;
      max-width: 100%;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    h1, h2, h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-weight: 600;
      line-height: 1.1;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .btn {
      display: inline-block;
      font-size: .875rem;
      letter-spacing: .02em;
      padding: 14px 32px;
      border-radius: 999px;
      transition: all .3s ease;
      cursor: pointer;
      border: none;
    }

    .btn-primary {
      background: var(--tan);
      color: var(--iron);
    }

    .btn-primary:hover {
      background: var(--cream);
    }

    .btn-outline {
      border: 1px solid rgba(242, 240, 230, .4);
      color: var(--cream);
    }

    .btn-outline:hover {
      background: rgba(242, 240, 230, .1);
    }

    .eyebrow {
      font-size: .7rem;
      letter-spacing: .3em;
      text-transform: uppercase;
    }

    header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      transition: all .5s ease;
    }

    header.scrolled {
      background: rgba(26, 20, 16, .95);
      backdrop-filter: blur(8px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, .25);
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 80px;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }

    .brand .name {
      font-family: 'Playfair Display', serif;
      font-size: 1.7rem;
      color: var(--cream);
    }

    .brand .sub {
      font-size: .62rem;
      letter-spacing: .35em;
      text-transform: uppercase;
      color: var(--tan);
      margin-top: 4px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 36px;
      list-style: none;
    }

    .nav-links a {
      font-size: .875rem;
      color: rgba(242, 240, 230, .85);
      transition: color .3s;
    }

    .nav-links a:hover {
      color: var(--tan);
    }

    .nav-reserve {
      font-size: .875rem;
      padding: 10px 24px;
      border-radius: 999px;
      border: 1px solid var(--tan);
      color: var(--tan);
      transition: all .3s;
    }

    .nav-reserve:hover {
      background: var(--tan);
      color: var(--iron);
    }

    .burger {
      display: none;
      background: none;
      border: none;
      color: var(--cream);
      cursor: pointer;
      padding: 8px;
    }

    .mobile-menu {
      display: none;
      max-height: 0;
      overflow: hidden;
      transition: max-height .5s ease;
      background: rgba(26, 20, 16, .98);
      backdrop-filter: blur(8px);
    }

    .mobile-menu.open {
      max-height: 28rem;
    }

    .mobile-menu ul {
      list-style: none;
      padding: 16px 20px;
    }

    .mobile-menu li a {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid rgba(242, 240, 230, .1);
      color: rgba(242, 240, 230, .9);
    }

    .mobile-menu .btn {
      width: 100%;
      text-align: center;
      margin-top: 12px;
    }

    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero .bg {
      position: absolute;
      inset: 0;
    }

    .hero .bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 45%;
    }

    .hero .overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(26, 20, 16, .7), rgba(26, 20, 16, .4), rgba(26, 20, 16, .85));
    }

    .hero-content {
      position: relative;
      z-index: 10;
      text-align: center;
      padding: 80px 20px 0;
      max-width: 760px;
      margin: 0 auto;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      background: rgba(26, 20, 16, .4);
      border: 1px solid rgba(210, 180, 140, .4);
      backdrop-filter: blur(4px);
      margin-bottom: 32px;
    }

    .badge .stars {
      display: flex;
      gap: 2px;
      color: var(--tan);
    }

    .badge span {
      font-size: .7rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: rgba(242, 240, 230, .9);
    }

    .hero h1 {
      font-size: clamp(3rem, 9vw, 5.5rem);
      color: var(--cream);
      letter-spacing: -.02em;
    }

    .hero .tagline {
      margin-top: 24px;
      font-family: 'Playfair Display', serif;
      font-style: italic;
      color: var(--tan);
      font-size: clamp(1.25rem, 3vw, 1.5rem);
    }

    .hero p.desc {
      margin-top: 20px;
      color: rgba(242, 240, 230, .85);
      font-size: 1.05rem;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta {
      margin-top: 40px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      align-items: center;
    }

    .hero-loc {
      margin-top: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: rgba(242, 240, 230, .7);
      font-size: .75rem;
    }

    .scroll-cue {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(242, 240, 230, .7);
      animation: bounce 2s infinite;
    }

    @keyframes bounce {
      0%, 100% {
        transform: translateX(-50%) translateY(0);
      }
      50% {
        transform: translateX(-50%) translateY(8px);
      }
    }

    .section {
      padding: 96px 0;
    }

    .section-head {
      text-align: center;
      max-width: 640px;
      margin: 0 auto;
    }

    .section-head .eyebrow {
      color: var(--terracotta);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }

    .dark .section-head .eyebrow {
      color: var(--tan);
    }

    .section-head h2 {
      font-size: clamp(2.2rem, 5vw, 3rem);
      color: var(--espresso);
    }

    .dark .section-head h2 {
      color: var(--cream);
    }

    .section-head p {
      margin-top: 20px;
      color: rgba(62, 43, 36, .8);
      font-size: 1.05rem;
    }

    .dark .section-head p {
      color: rgba(242, 240, 230, .7);
    }

    .about {
      background: var(--cream);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
      align-items: center;
    }

    .about-media {
      position: relative;
    }

    .about-media .main {
      border-radius: 2rem;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(62, 43, 36, .25);
    }

    .about-media .main img {
      width: 100%;
      height: 544px;
      object-fit: cover;
    }

    .about-media .sub-img {
      display: none;
      position: absolute;
      bottom: -32px;
      right: -24px;
      width: 176px;
      height: 176px;
      border-radius: 1.5rem;
      overflow: hidden;
      border: 4px solid var(--cream);
      box-shadow: 0 12px 30px rgba(0, 0, 0, .2);
    }

    .about-media .sub-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .rating-badge {
      position: absolute;
      top: -24px;
      left: -24px;
      background: var(--iron);
      color: var(--cream);
      border-radius: 1rem;
      padding: 16px 24px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }

    .rating-badge .stars {
      display: flex;
      gap: 4px;
      color: var(--tan);
    }

    .rating-badge .num {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      margin-top: 4px;
    }

    .rating-badge .lbl {
      font-size: .62rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--tan);
    }

    .about-text .eyebrow {
      color: var(--terracotta);
      margin-bottom: 20px;
      display: block;
    }

    .about-text h2 {
      font-size: clamp(2rem, 5vw, 2.8rem);
      color: var(--espresso);
    }

    .about-text p {
      margin-top: 20px;
      color: rgba(62, 43, 36, .8);
      font-size: 1.05rem;
    }

    .about-stats {
      margin-top: 40px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .about-stats .n {
      font-family: 'Playfair Display', serif;
      font-size: 1.875rem;
      color: var(--terracotta);
    }

    .about-stats .l {
      font-size: .7rem;
      letter-spacing: .05em;
      text-transform: uppercase;
      color: rgba(62, 43, 36, .6);
      margin-top: 4px;
    }

    .menu {
      background: var(--iron);
      position: relative;
      overflow: hidden;
    }

    .menu::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: .04;
      background: radial-gradient(circle at 20% 20%, var(--tan), transparent 40%), radial-gradient(circle at 80% 80%, var(--terracotta), transparent 40%);
      pointer-events: none;
    }

    .menu-grid {
      margin-top: 64px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .dish {
      background: #241B14;
      border-radius: 1.75rem;
      overflow: hidden;
      border: 1px solid rgba(210, 180, 140, .15);
      transition: border-color .5s;
    }

    .dish:hover {
      border-color: rgba(210, 180, 140, .4);
    }

    .dish .img {
      position: relative;
      height: 256px;
      overflow: hidden;
    }

    .dish .img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .7s;
    }

    .dish:hover .img img {
      transform: scale(1.05);
    }

    .dish .img::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, #241B14, transparent);
    }

    .dish .body {
      padding: 28px;
    }

    .dish h3 {
      font-size: 1.5rem;
      color: var(--cream);
    }

    .dish p {
      margin-top: 12px;
      color: rgba(242, 240, 230, .65);
    }

    .menu-cta {
      margin-top: 56px;
      text-align: center;
    }

    .menu-cta .note {
      margin-top: 16px;
      font-size: .75rem;
      color: rgba(242, 240, 230, .45);
    }

    .hours {
      background: var(--cream);
    }

    .hours-grid {
      margin-top: 56px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
    }

    .day {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px;
      border-radius: 1rem;
      border: 1px solid transparent;
      transition: all .3s;
    }

    .day.closed {
      background: rgba(62, 43, 36, .05);
      border-color: rgba(62, 43, 36, .1);
    }

    .day.open {
      background: #fff;
      border-color: rgba(166, 94, 78, .2);
      box-shadow: 0 1px 3px rgba(0, 0, 0, .04);
    }

    .day .d {
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      color: var(--espresso);
    }

    .day .t {
      font-size: .875rem;
      letter-spacing: .02em;
    }

    .day.closed .t {
      color: rgba(62, 43, 36, .45);
    }

    .day.open .t {
      color: var(--terracotta);
      font-weight: 500;
    }

    .hours-cta {
      margin-top: 48px;
      text-align: center;
      background: var(--espresso);
      border-radius: 1.5rem;
      padding: 40px 32px;
    }

    .hours-cta h3 {
      font-size: 1.5rem;
      color: var(--cream);
    }

    .hours-cta p {
      margin-top: 8px;
      color: rgba(242, 240, 230, .7);
    }

    .location {
      background: var(--iron);
    }

    .loc-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
      align-items: stretch;
    }

    .loc-text .eyebrow {
      color: var(--tan);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }

    .loc-text h2 {
      font-size: clamp(2rem, 5vw, 2.8rem);
      color: var(--cream);
    }

    .loc-text .addr {
      margin-top: 24px;
      color: rgba(242, 240, 230, .7);
      font-size: 1.05rem;
    }

    .loc-actions {
      margin-top: 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .loc-actions .link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: .875rem;
      padding: 12px 24px;
      border-radius: 999px;
      border: 1px solid rgba(210, 180, 140, .5);
      color: var(--tan);
      transition: all .3s;
      width: fit-content;
    }

    .loc-actions .link:hover {
      background: var(--tan);
      color: var(--iron);
    }

    .loc-actions .phone {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: rgba(242, 240, 230, .85);
      transition: color .3s;
    }

    .loc-actions .phone:hover {
      color: var(--tan);
    }

    .loc-map {
      border-radius: 1.75rem;
      overflow: hidden;
      border: 1px solid rgba(210, 180, 140, .2);
      box-shadow: 0 25px 60px rgba(0, 0, 0, .4);
      min-height: 384px;
    }

    .loc-map iframe {
      width: 100%;
      height: 100%;
      min-height: 384px;
      border: 0;
    }

    footer {
      background: #0F0B08;
      padding-top: 80px;
      padding-bottom: 40px;
    }

    .foot-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .foot-brand h3 {
      font-size: 1.875rem;
      color: var(--cream);
    }

    .foot-brand .sub {
      font-size: .7rem;
      letter-spacing: .3em;
      text-transform: uppercase;
      color: var(--tan);
      margin-top: 8px;
    }

    .foot-brand p {
      margin-top: 20px;
      color: rgba(242, 240, 230, .6);
      max-width: 240px;
    }

    .foot-col .eyebrow {
      color: var(--tan);
      margin-bottom: 20px;
      display: block;
    }

    .foot-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .foot-col a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: rgba(242, 240, 230, .75);
      transition: color .3s;
    }

    .foot-col a:hover {
      color: var(--tan);
    }

    .foot-col a .ic {
      color: var(--tan);
    }

    .socials {
      display: flex;
      gap: 16px;
    }

    .socials a {
      width: 44px;
      height: 44px;
      border-radius: 999px;
      border: 1px solid rgba(210, 180, 140, .4);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--tan);
      transition: all .3s;
    }

    .socials a:hover {
      background: var(--tan);
      color: var(--iron);
    }

    .foot-bottom {
      margin-top: 64px;
      padding-top: 32px;
      border-top: 1px solid rgba(242, 240, 230, .1);
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
    }

    .foot-bottom p {
      font-size: .75rem;
      color: rgba(242, 240, 230, .4);
    }

    @media (min-width: 900px) {
      .about-grid {
        grid-template-columns: 1fr 1fr;
        gap: 80px;
      }
      .about-media .sub-img {
        display: block;
      }
      .menu-grid {
        grid-template-columns: 1fr 1fr;
      }
      .hours-grid {
        grid-template-columns: 1fr 1fr;
      }
      .loc-grid {
        grid-template-columns: 1fr 1fr;
        gap: 64px;
      }
      .foot-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      .foot-bottom {
        flex-direction: row;
      }
    }

    @media (min-width: 1024px) {
      .nav-links {
        display: flex;
      }
      .nav-reserve {
        display: inline-block;
      }
      .burger {
        display: none;
      }
      .mobile-menu {
        display: none !important;
      }
      .hero-cta {
        flex-direction: row;
        justify-content: center;
      }
    }

    @media (max-width: 1023px) {
      .nav-links {
        display: none;
      }
      .nav-reserve {
        display: none;
      }
      .burger {
        display: block;
      }
      .mobile-menu {
        display: block;
      }
    }
  </style>
</head>
<body>

  <header id="header">
    <nav>
      <a href="#inicio" class="brand">
        <span class="name">Bistro Torres</span>
        <span class="sub">Valle de Bravo</span>
      </a>
      <ul class="nav-links">
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
        <li><a href="#carta">Carta</a></li>
        <li><a href="#horarios">Horarios</a></li>
        <li><a href="#ubicacion">Ubicación</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
      <a class="nav-reserve" href="https://wa.me/527293707396?text=Hola%20Bistro%20Torres,%20me%20gustaría%20reservar%20una%20mesa" target="_blank" rel="noopener">Reservar mesa</a>
      <button class="burger" id="burger" aria-label="Abrir menú">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </nav>
    <div class="mobile-menu" id="mobileMenu">
      <ul>
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
        <li><a href="#carta">Carta</a></li>
        <li><a href="#horarios">Horarios</a></li>
        <li><a href="#ubicacion">Ubicación</a></li>
        <li><a href="#contacto">Contacto</a></li>
        <li><a class="btn btn-primary" href="https://wa.me/527293707396?text=Hola%20Bistro%20Torres,%20me%20gustaría%20reservar%20una%20mesa" target="_blank" rel="noopener">Reservar mesa</a></li>
      </ul>
    </div>
  </header>

  <section class="hero" id="inicio">
    <div class="bg">
      <img src="https://media.base44.com/images/public/user_6a9cf72266f7b2377a14ce76/0689a2100_Screenshot_2026-09-05-22-41-02-33_3d9111e2d3171bf4882369f490c087b4.jpg" alt="Terraza del Bistro Torres con vista al lago de Valle de Bravo">
    </div>
    <div class="overlay"></div>
    <div class="hero-content">
      <div class="badge">
        <span class="stars">★★★★★</span>
        <span>4.7 · Valoración de nuestros comensales</span>
      </div>
      <h1>Bistro Torres</h1>
      <p class="tagline">Cocina de autor frente al lago</p>
      <p class="desc">Sabores que enamoran con la mejor vista de Valle de Bravo. Ingredientes frescos, ambiente rústico-colonial y mesas junto al agua.</p>
